# ScreenMind Configuration
# Copy this to .env and adjust as needed.
# Lookup order: ~/.screenmind/.env (recommended, survives reinstalls),
# then ./.env (current working directory). Real env vars win over both.

# Capture Settings
CAPTURE_INTERVAL=30
SCREENSHOT_QUALITY=70
DATA_DIR=~/.screenmind

# Model Settings
GEMMA_MODE=local
# GEMMA_MODE=api  # WARNING: sends screenshots to Google AI Studio — disables local-only guarantee
# GOOGLE_API_KEY=your-key-here

# Custom OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, cloud providers, ...)
# GEMMA_MODE=custom
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your-api-key-here   # leave unset if the endpoint needs no key
# LLM_MODEL_NAME=gemma4:e2b
# Optional second model for text-only operations (summaries, chat, agents).
# Screenshots/audio always use LLM_MODEL_NAME.
# It can ride the primary endpoint (leave TEXT_LLM_API_BASE_URL empty) or run
# on its own OpenAI-compatible endpoint.
# TEXT_LLM_API_BASE_URL=        # e.g. https://api.openai.com/v1; empty = primary endpoint
# TEXT_LLM_API_KEY=             # empty = reuse LLM_API_KEY (only when sharing the endpoint)
# TEXT_LLM_MODEL_NAME=          # e.g. a large-context model; empty = disabled
# TEXT_LLM_ROUTING=off          # off | overflow (text requests exceeding Context Window) | always (all text ops)
# TEXT_LLM_CONTEXT_WINDOW=32768 # context window of the text model, in tokens

# llama-server (local inference)
# NOTE: Do NOT set port in both LLAMA_SERVER_HOST and LLAMA_SERVER_PORT — they will silently diverge.
# LLAMA_SERVER_HOST=http://127.0.0.1:5809
# LLAMA_SERVER_PORT=5809

# Developer Context
WORKSPACE_DIRS=~/Projects,~/Desktop

# Privacy
BLOCKED_APPS=

# Hotkey
BOOKMARK_HOTKEY=ctrl+shift+b
